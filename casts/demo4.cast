[0.000, "o", "\u001b[7m==> demo 4 ready in MODE=throttled (cpu.max = 25000 100000)\u001b[0m\r\n"]
[0.000, "o", "     application  http://localhost:8083/compute\r\n"]
[0.000, "o", "     stats        curl -s http://localhost:8083/stats\r\n"]
[0.000, "o", "     the reveal   curl -s http://localhost:8083/throttle\r\n"]
[0.000, "o", "     cpu profile  curl -o cpu.pprof \"http://localhost:6063/debug/pprof/profile?seconds=15\"\r\n\r\n"]
[0.000, "o", "     0.25 cores against a workload that wants ~150ms of CPU per request.\r\n"]
[0.000, "o", "     The code is byte-for-byte identical to the corrected mode. Nothing was edited.\r\n"]
[0.005, "o", "\r\n"]
