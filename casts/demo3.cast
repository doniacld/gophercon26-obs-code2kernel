[0.112, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.000, "o", "\u001b[1mDemo 3 — lock contention: concurrent source is not parallel execution\u001b[0m\r\n"]
[0.000, "o", "\u001b[90m16 independent 100ms tasks, 11 processors, 1.6s. One mutex held across the work as well as the store.\u001b[0m\r\n"]
[0.000, "o", "\r\n"]
