[0.021, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.000, "o", "\u001b[1mDemo 1 — OpenTelemetry: independent calls made sequentially\u001b[0m\r\n"]
[0.000, "o", "\u001b[90mGET /dashboard takes ~766 ms. Fix: errgroup.WithContext. 766 ms -> 323 ms.\u001b[0m\r\n\r\n"]
