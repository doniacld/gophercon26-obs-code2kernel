[0.000, "o", "\u001b[7m  concurrency factor             1.00   sequential — a staircase\u001b[0m\r\n\r\n\u001b[7m  The children never overlapped. End-to-end latency is their sum.\u001b[0m\r\n"]
[0.010, "o", "\r\n"]
[2.014, "o", "\u001b[36m# Every # block starts where the previous one ends. That is the staircase.\u001b[0m\r\n"]
[1.518, "o", "\u001b[36m# Concurrency factor is sum(children) / wall clock they cover. 1.00 = no overlap.\u001b[0m\r\n"]
