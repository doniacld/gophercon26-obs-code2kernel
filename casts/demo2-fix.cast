[0.023, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.000, "o", "\u001b[1mDemo 2 — act 3: the fix\u001b[0m\r\n"]
[0.000, "o", "\u001b[90mserver.go — the handler pprof pointed at\u001b[0m\r\n\r\n"]
[2.018, "o", "\u001b[36m# The fix: the request's context, and a guarded send\u001b[0m\r\n"]
[1.574, "o", "\u001b[1m--- handleWorkBroken\u001b[0m\r\n\u001b[1m+++ handleWorkFixed\u001b[0m\r\n\u001b[36m@@ -1,15 +1,24 @@\u001b[0m\r\n"]
[0.000, "o", "\u001b[31m-func handleWorkBroken(w http.ResponseWriter, r *http.Request) {\u001b[0m\r\n\u001b[32m+func handleWorkFixed(w http.ResponseWriter, r *http.Request) {\u001b[0m\r\n\u001b[32m+\tctx := r.Context()\u001b[0m\r\n \tresults := make(chan Result)\r\n \r\n \tgo func() {\r\n"]
[0.000, "o", "\u001b[31m-\t\tresult := doWork(context.Background())\u001b[0m\r\n"]
[0.000, "o", "\u001b[31m-\t\tresults <- result // leaks: nobody receives after the handler returns\u001b[0m\r\n\u001b[32m+\t\tresult, err := doWorkCancellable(ctx)\u001b[0m\r\n\u001b[32m+\t\tif err != nil {\u001b[0m\r\n\u001b[32m+\t\t\treturn\u001b[0m\r\n\u001b[32m+\t\t}\u001b[0m\r\n\u001b[32m+\u001b[0m\r\n\u001b[32m+\t\tselect {\u001b[0m\r\n\u001b[32m+\t\tcase results <- result:\u001b[0m\r\n"]
[0.000, "o", "\u001b[32m+\t\tcase <-ctx.Done():\u001b[0m\r\n\u001b[32m+\t\t\treturn\u001b[0m\r\n\u001b[32m+\t\t}\u001b[0m\r\n"]
[0.000, "o", " \t}()\r\n"]
[0.000, "o", " \r\n \tselect {\r\n"]
[0.000, "o", " \tcase result := <-results:\r\n \t\twriteResult(w, result)\r\n\u001b[31m-\tcase <-r.Context().Done():\u001b[0m\r\n"]
[0.000, "o", "\u001b[32m+\tcase <-ctx.Done():\u001b[0m\r\n"]
[0.000, "o", " \t\treturn\r\n \t}\r\n"]
[0.000, "o", " }\r\n"]
[0.017, "o", "\r\n"]
