[0.017, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.000, "o", "\u001b[1mDemo 1 — the change\u001b[0m\r\n"]
[0.000, "o", "\u001b[90minternal/dashboard/dashboard.go — the same three calls, issued differently\u001b[0m\r\n\r\n"]
[2.021, "o", "\u001b[36m# The fix: fetch the three dependencies concurrently\u001b[0m\r\n"]
[1.578, "o", "\u001b[1m--- Sequential\u001b[0m\r\n\u001b[1m+++ Concurrent\u001b[0m\r\n"]
[0.000, "o", "\u001b[36m@@ -1,14 +1,21 @@\u001b[0m\r\n"]
[0.000, "o", "\u001b[31m-func (c *Client) Sequential(ctx context.Context) (*Response, error) {\u001b[0m\r\n\u001b[32m+func (c *Client) Concurrent(ctx context.Context) (*Response, error) {\u001b[0m\r\n"]
[0.000, "o", " \tstart := time.Now()\r\n \tresults := make([]Result, len(c.Dependencies))\r\n \r\n"]
[0.000, "o", "\u001b[32m+\tg, gctx := errgroup.WithContext(ctx)\u001b[0m\r\n"]
[0.000, "o", " \tfor i, dep := range c.Dependencies {\r\n\u001b[31m-\t\tres, err := c.fetch(ctx, dep)\u001b[0m\r\n\u001b[31m-\t\tif err != nil {\u001b[0m\r\n"]
[0.000, "o", "\u001b[31m-\t\t\treturn nil, fmt.Errorf(\"%s: %w\", dep.Name, err)\u001b[0m\r\n"]
[0.000, "o", "\u001b[31m-\t\t}\u001b[0m\r\n"]
[0.001, "o", "\u001b[31m-\t\tresults[i] = res\u001b[0m\r\n"]
[0.000, "o", "\u001b[32m+\t\tg.Go(func() error {\u001b[0m\r\n"]
[0.000, "o", "\u001b[32m+\t\t\tres, err := c.fetch(gctx, dep)\u001b[0m\r\n"]
[0.000, "o", "\u001b[32m+\t\t\tif err != nil {\u001b[0m\r\n"]
[0.000, "o", "\u001b[32m+\t\t\t\treturn fmt.Errorf(\"%s: %w\", dep.Name, err)\u001b[0m\r\n\u001b[32m+\t\t\t}\u001b[0m\r\n"]
[0.000, "o", "\u001b[32m+\t\t\tresults[i] = res\u001b[0m\r\n"]
[0.000, "o", "\u001b[32m+\t\t\treturn nil\u001b[0m\r\n"]
[0.000, "o", "\u001b[32m+\t\t})\u001b[0m\r\n"]
[0.000, "o", " \t}\r\n"]
[0.000, "o", "\u001b[32m+\tif err := g.Wait(); err != nil {\u001b[0m\r\n\u001b[32m+\t\treturn nil, err\u001b[0m\r\n"]
[0.000, "o", "\u001b[32m+\t}\u001b[0m\r\n \r\n"]
[0.000, "o", "\u001b[31m-\treturn c.response(\"sequential\", results, time.Since(start)), nil\u001b[0m\r\n"]
[0.000, "o", "\u001b[32m+\treturn c.response(\"concurrent\", results, time.Since(start)), nil\u001b[0m\r\n }\r\n"]
[0.011, "o", "\r\n"]
