{"version":3,"term":{"cols":120,"rows":40},"timestamp":1785740694,"command":"./scripts/cast-demo2-pprof.sh","title":"Demo 2 — act 2: the profile","env":{"SHELL":"/bin/zsh"}}
[0.026, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.000, "o", "\u001b[1mDemo 2 — act 2: the profile\u001b[0m\r\n"]
[0.001, "o", "\u001b[90mserver.go — one more handler on the diagnostics listener\u001b[0m\r\n"]
[0.000, "o", "\r\n"]
[2.026, "o", "\u001b[36m# Add pprof to the diagnostics endpoint\u001b[0m\r\n"]
[1.589, "o", "\u001b[1m--- diagnosticsMetrics\u001b[0m\r\n\u001b[1m+++ diagnosticsProfiling\u001b[0m\r\n\u001b[36m@@ -1,4 +1,4 @@\u001b[0m\r\n"]
[0.000, "o", "\u001b[31m-func diagnosticsMetrics() *http.ServeMux {\u001b[0m\r\n\u001b[32m+func diagnosticsProfiling() *http.ServeMux {\u001b[0m\r\n \tregistry := prometheus.NewRegistry()\r\n \tregistry.MustRegister(\r\n \t\tcollectors.NewGoCollector(),\r\n"]
[0.000, "o", "\u001b[36m@@ -7,6 +7,9 @@\u001b[0m\r\n"]
[0.000, "o", " \r\n"]
[0.000, "o", " \tmux := http.NewServeMux()\r\n"]
[0.000, "o", " \tmux.Handle(\"/metrics\", promhttp.HandlerFor(registry, promhttp.HandlerOpts{}))\r\n"]
[0.000, "o", "\u001b[32m+\t// net/http/pprof registers itself on DefaultServeMux, so delegating the whole\u001b[0m\r\n\u001b[32m+\t// prefix is how /debug/pprof/* reaches it from a mux of our own.\u001b[0m\r\n"]
[0.000, "o", "\u001b[32m+\tmux.Handle(\"/debug/pprof/\", http.DefaultServeMux)\u001b[0m\r\n \r\n \treturn mux\r\n"]
[0.000, "o", " }\r\n"]
[0.013, "o", "\r\n"]
[3.018, "o", "\u001b[36m# Restart the service\u001b[0m\r\n"]
[1.562, "o", "\u001b[90m$ \u001b[0m."]
